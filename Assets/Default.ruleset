    <Rule Id="USP0011" Action="Error" />
    <Rule Id="USP0012" Action="Error" />
    <Rule Id="USP0013" Action="Error" />
    <Rule Id="USP0014" Action="Error" />
    <Rule Id="USP0015" Action="Error" />
    <Rule Id="USP0016" Action="Error" />
    <Rule Id="USP0017" Action="Error" />
    <Rule Id="USP0018" Action="Error" />
    <Rule Id="USP0019" Action="Error" />
    <Rule Id="USP0020" Action="Error" />
